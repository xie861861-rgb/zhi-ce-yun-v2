# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=zhi-ce-yun-v2-secret-key-change-in-production

# Database
DATABASE_URL="file:./dev.db"

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ========================
# 数据源 API 配置
# ========================

# 阿里拍卖 API
# 申请地址: https://market.aliyun.com/products
ALI_AUCTION_APP_KEY=your-ali-auction-app-key
ALI_AUCTION_APP_SECRET=your-ali-auction-app-secret

# 京东法拍 API
# 申请地址: https://market.jd.com
JD_AUCTION_APP_KEY=your-jd-auction-app-key
JD_AUCTION_APP_SECRET=your-jd-auction-app-secret

# 房估估房产估值 API
# 申请地址: https://api.fanggugu.com
FANGGUGU_APP_KEY=your-fanggugu-app-key

# 汇法网司法数据 API
# 申请地址: https://www.huifawang.com
HUIFAWANG_APP_KEY=your-huifawang-app-key

# Tushare 金融数据
# 申请地址: https://tushare.pro
TUSHARE_TOKEN=your-tushare-token
